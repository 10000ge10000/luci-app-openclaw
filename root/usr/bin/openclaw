#!/bin/sh

[ -r /usr/libexec/openclaw-paths.sh ] && . /usr/libexec/openclaw-paths.sh

configured_path="${OPENCLAW_INSTALL_PATH:-$(uci -q get openclaw.main.install_path 2>/dev/null || echo /opt)}"
if command -v oc_load_paths >/dev/null 2>&1; then
	oc_load_paths "$configured_path" || {
		echo "Invalid OpenClaw install path: $configured_path" >&2
		exit 1
	}
else
	OC_ROOT="${configured_path%/}/openclaw"
	NODE_BASE="$OC_ROOT/node"
	OC_GLOBAL="$OC_ROOT/global"
	OC_DATA="$OC_ROOT/data"
	CONFIG_FILE="$OC_DATA/.openclaw/openclaw.json"
fi

node="$NODE_BASE/bin/node"
[ -x "$node" ] || { echo "OpenClaw Node.js not found: $node" >&2; exit 127; }

entry=""
for candidate in "$OC_GLOBAL/lib/node_modules/openclaw/openclaw.mjs" "$OC_GLOBAL/lib/node_modules/openclaw/dist/cli.js" "$OC_GLOBAL/node_modules/openclaw/openclaw.mjs" "$OC_GLOBAL/node_modules/openclaw/dist/cli.js" "$NODE_BASE/lib/node_modules/openclaw/openclaw.mjs" "$NODE_BASE/lib/node_modules/openclaw/dist/cli.js"; do
	[ -f "$candidate" ] && { entry="$candidate"; break; }
done
[ -n "$entry" ] || { echo "OpenClaw CLI entry not found under $OC_ROOT" >&2; exit 127; }

export HOME="$OC_DATA"
export OPENCLAW_HOME="$OC_DATA"
export OPENCLAW_STATE_DIR="$OC_DATA/.openclaw"
export OPENCLAW_CONFIG_PATH="$CONFIG_FILE"
export NODE_ICU_DATA="$NODE_BASE/share/icu"
export PATH="$NODE_BASE/bin:$OC_GLOBAL/bin:$PATH"

exec "$node" "$entry" "$@"
